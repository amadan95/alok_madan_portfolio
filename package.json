{
  "name": "portfolio-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "catalog": "python3 scripts/build_catalog.py --check",
    "catalog:generate": "python3 scripts/build_catalog.py --generate --check",
    "catalog:prune": "python3 scripts/build_catalog.py --prune-stale",
    "build": "python3 scripts/build_catalog.py --check && cd site && npm run build:internal",
    "start": "python3 scripts/serve_export.py",
    "typecheck": "cd site && npm run typecheck",
    "lint": "cd site && npm run lint",
    "test": "python3 -m unittest discover -s tests && cd site && npm run test",
    "test:export": "cd site && npm run test:export",
    "check": "npm run catalog && npm run typecheck && npm run lint && npm run test",
    "release:check": "npm run check && npm run build && npm run test:export"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "next": "^15.2.0",
    "next-transition-router": "^0.2.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.2"
  }
}
